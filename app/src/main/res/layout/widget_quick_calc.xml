<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_background"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="محاسبه سریع"
            android:textColor="#F7D370"
            android:textStyle="bold"
            android:textSize="15sp"
            android:gravity="right" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GOLD BAR • لمس هر بخش برای تغییر عدد"
            android:textColor="#9BA1AD"
            android:textSize="9sp"
            android:gravity="right"
            android:paddingTop="1dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_split_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/widget_item_background">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تقسیم ۳۶.۷۹٪ / ۶۳.۲۱٪"
            android:textColor="#F6F4ED"
            android:textStyle="bold"
            android:textSize="11sp"
            android:gravity="right" />

        <TextView
            android:id="@+id/widget_split_base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عدد پایه: 800"
            android:textColor="#9BA1AD"
            android:textSize="10sp"
            android:gravity="right"
            android:paddingTop="3dp" />

        <TextView
            android:id="@+id/widget_split_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="۳۶.۷۹٪ 294.32  •  ۶۳.۲۱٪ 505.68"
            android:textColor="#F7D370"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="right"
            android:paddingTop="3dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_correction_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/widget_item_background">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اصلاح وزن برای افت عیار"
            android:textColor="#F6F4ED"
            android:textStyle="bold"
            android:textSize="11sp"
            android:gravity="right" />

        <TextView
            android:id="@+id/widget_correction_inputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="وزن 250g  •  هدف 750  •  افت 1"
            android:textColor="#9BA1AD"
            android:textSize="10sp"
            android:gravity="right"
            android:paddingTop="3dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_correction_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="بار افزوده 0.334g  •  جمع وزن 250.334g"
            android:textColor="#F7D370"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="right"
            android:paddingTop="3dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
